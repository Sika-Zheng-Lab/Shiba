# Development image; deliberately uses the same runtime as production.
FROM mambaorg/micromamba:2.5

LABEL maintainer="Naoto Kubota <naotok@ucr.edu>"
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/Sika-Zheng-Lab/Shiba"
LABEL org.opencontainers.image.revision=$GIT_SHA

COPY --chown=$MAMBA_USER:$MAMBA_USER environment.yml /tmp/environment.yml
RUN micromamba install --yes --name base --file /tmp/environment.yml && \
    micromamba clean --all --yes

ARG MAMBA_DOCKERFILE_ACTIVATE=1
ENV PATH=/opt/conda/bin:$PATH

USER root
COPY . /opt/Shiba
RUN chmod -R a+rX /opt/Shiba && \
    ln -sf /opt/Shiba/shiba.py /opt/conda/bin/shiba.py && \
    ln -sf /opt/Shiba/scshiba.py /opt/conda/bin/scshiba.py
USER $MAMBA_USER

RUN python /opt/Shiba/scripts/verify_runtime.py
WORKDIR /home
CMD ["bash"]
